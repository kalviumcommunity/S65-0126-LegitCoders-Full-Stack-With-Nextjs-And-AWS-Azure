# Database
DATABASE_URL=postgresql://user:password@localhost:5432/flood_warning_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# External APIs
OPENWEATHERMAP_API_KEY=your_api_key_here
WEATHER_API_CACHE_TTL=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Job
CRON_JOB_INTERVAL=15

# Logging
LOG_LEVEL=debug
